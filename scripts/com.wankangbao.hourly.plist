<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS 定时任务：每个整点过 1 分钟跑一次腕康宝。
  1. 把下面两处 /path/to/wankangbao 换成你的仓库路径
  2. cp scripts/com.wankangbao.hourly.plist ~/Library/LaunchAgents/
  3. launchctl load ~/Library/LaunchAgents/com.wankangbao.hourly.plist
  日志在 workspace/launchd.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wankangbao.hourly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/wankangbao/.venv/bin/python</string>
    <string>/path/to/wankangbao/start.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/path/to/wankangbao</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>1</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/path/to/wankangbao/workspace/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/wankangbao/workspace/launchd.log</string>
</dict>
</plist>
